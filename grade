float grade;
cout << "Enter your grade: ";
cin >> grade;

char letter_grade;

if (grade > 100 || grade < 0) {
    letter_grade = 'U';
} else if (grade >= 90 && grade <= 100) {
    letter_grade = 'A';
} else if (grade >= 80 && grade < 90) {
    letter_grade = 'B';
} else if (grade >= 70 && grade < 80) {
    letter_grade = 'C';
} else if (grade >= 60 && grade < 70) {
    letter_grade = 'D';
} else {
    letter_grade = 'F';

cout << "Your letter grade of " << grade << " is "
    << letter_grade << "." << endl;

return 0;
}